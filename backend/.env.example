# ==============================================================================
# VPS Metrics Dashboard — Backend Environment Variables
# ==============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit the real .env file to version control.
# ==============================================================================

# --- Server ---
# Port the backend HTTP server listens on.
# Default: 3012
PORT=3012

# --- Security ---
# API Key required to connect via WebSocket. 
# IMPORTANT: Set a strong, random secret in production.
# If left empty, the server starts WITHOUT authentication (development only).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=
